        ]
      },
      "convert-mock": {
        "methods": [
          "convertMock"
        ]
      },
      "save-dirs": {
        "methods": [
          "saveDirs"
        ]
      },
      "get-dirs": {
        "methods": [
          "getDirs"
        ]
      }
    }
  },
